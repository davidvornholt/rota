# A11y fixture, NO secrets: the Playwright web server boots with this; the
# scanned pages (unauthenticated surface) touch neither database nor OAuth. The
# scan stays green because session reads fail closed and the scanned routes
# never reach the database. `bun --env-file` only fills in keys the process
# environment has not set already, so an exported value wins over this file.
# PORT 3110 keeps the scan clear of dev servers and other apps' a11y suites.
PORT=3110
DATABASE_URL=postgresql://a11y:a11y@127.0.0.1:15434/a11y_fixture
BETTER_AUTH_URL=http://127.0.0.1:3110
BETTER_AUTH_SECRET=a11y-fixture-not-a-secret-0123456789012345
GITHUB_CLIENT_ID=a11y-fixture-client-id
GITHUB_CLIENT_SECRET=a11y-fixture-client-secret
GITHUB_ALLOWED_ACCOUNT_ID=157214705
BEDROCK_MODEL=global.anthropic.claude-sonnet-5-5
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=a11y-fixture
AWS_SECRET_ACCESS_KEY=a11y-fixture
FOUNDRY_OPENAI_ENDPOINT=http://127.0.0.1:9
FOUNDRY_OPENAI_API_KEY=a11y-fixture-key
FOUNDRY_IMAGE_DEPLOYMENT=gpt-image-2
MEDIA_STORE=local
MEDIA_LOCAL_DIR=.media-a11y
