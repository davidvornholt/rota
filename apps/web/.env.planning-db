# Planning database check fixture, NO secrets. The check stubs Claude, the
# forecast and the media store, but the app modules it loads validate the whole
# server environment, so these placeholders satisfy that validation. DATABASE_URL
# is deliberately absent: it must come from the environment (CI's Postgres
# service, or `bun --env-file=.env.local run test:planning-db` locally), and
# without it the check skips locally and fails in CI. `bun --env-file` only
# fills in keys the process environment has not set already.
BETTER_AUTH_URL=http://127.0.0.1:3120
BETTER_AUTH_SECRET=planning-db-fixture-not-a-secret-0123456789
GITHUB_CLIENT_ID=planning-db-fixture-client-id
GITHUB_CLIENT_SECRET=planning-db-fixture-client-secret
GITHUB_ALLOWED_ACCOUNT_ID=1
ANTHROPIC_API_KEY=planning-db-fixture
FOUNDRY_OPENAI_ENDPOINT=http://127.0.0.1:9
FOUNDRY_OPENAI_API_KEY=planning-db-fixture-key
FOUNDRY_IMAGE_DEPLOYMENT=gpt-image-2
FOUNDRY_COLLAGE_DEPLOYMENT=gpt-image-2
MEDIA_STORE=local
MEDIA_LOCAL_DIR=.media-planning-db
