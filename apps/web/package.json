{
  "name": "@rota/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "bun run scripts/serve.ts",
    "db:migrate": "bun --env-file=.env.local run scripts/migrate.ts",
    "db:migrate:deploy": "bun run scripts/migrate.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "test:a11y": "playwright test --config playwright.config.ts",
    "test:planning-db": "bun --env-file=.env.local run scripts/verify-planning.ts",
    "test:family": "bun --env-file=.env.local run scripts/family-check.ts",
    "test:oauth": "bun --env-file=.env.local run scripts/oauth-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@better-auth/passkey": "1.7.19",
    "@effect/sql-pg": "^4.1.3",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@rota/api": "workspace:*",
    "@rota/db": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "better-auth": "^1.7.19",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.1.2",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@davidvornholt/a11y-testing": "workspace:*",
    "@davidvornholt/typescript-config": "workspace:*",
    "@playwright/test": "1.65.0",
    "@tanstack/router-cli": "^1.168.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "7.0.2",
    "vite": "^8.3.7"
  }
}
