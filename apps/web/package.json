{
  "name": "@rota/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "bun run scripts/serve.ts",
    "db:migrate": "bun --env-file=.env.local run scripts/migrate.ts",
    "db:migrate:deploy": "bun run scripts/migrate.ts",
    "check-types": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "test": "bun test",
    "test:a11y": "playwright test --config playwright.config.ts",
    "test:planning-db": "bun --env-file=.env.local run scripts/verify-planning.ts",
    "test:family": "bun --env-file=.env.local run scripts/family-check.ts",
    "test:oauth": "bun --env-file=.env.local run scripts/oauth-check.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.6",
    "@effect/sql": "^0.52.1",
    "@effect/sql-pg": "^0.53.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@google/genai": "^2.24.0",
    "@rota/db": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.58",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "effect": "^3.22.2",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@davidvornholt/a11y-testing": "workspace:*",
    "@davidvornholt/typescript-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tanstack/router-cli": "^1.167.38",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "7.0.2",
    "vite": "^8.3.1"
  }
}
