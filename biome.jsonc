{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  // Repo-owned wrapper. Extends the canonical strict base synced from
  // davidvornholt/standards. Add project-specific overrides here; never edit
  // biome.base.jsonc locally.
  "extends": ["./biome.base.jsonc"],
  "files": {
    // Claude workflow scripts are a sandboxed DSL dialect (ambient
    // orchestration globals, top-level return) that Biome's ES module
    // parser rejects; the Workflow harness validates them at run time.
    // Claude agent worktrees are full checkouts with their own root
    // biome.jsonc; nested biome.json(c) files are scanner-priority special
    // files, so only force-ignore (`!!`) guarantees they are never discovered
    // as nested roots.
    // routeTree.gen.ts is generated by TanStack Router on every dev/build run
    // and asks to be excluded from linting and formatting.
    // packages/db/drizzle is drizzle-kit's generated migration output; the
    // generator rewrites it on every `db:generate`.
    // apps/web/scripts/tmp holds throwaway local drive scripts and is not
    // part of the app.
    "includes": [
      "**",
      "!.claude/workflows",
      "!!.claude/worktrees",
      "!apps/web/src/routeTree.gen.ts",
      "!packages/db/drizzle",
      "!apps/web/scripts/tmp"
    ]
  },
  "overrides": [
    {
      // These framework boundaries require default exports as part of their
      // file-based configuration contracts (Vite, Playwright, Drizzle Kit).
      "includes": [
        "apps/web/vite.config.ts",
        "apps/web/playwright.config.ts",
        "packages/db/drizzle.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      // Designated environment boundary: env.ts reads process.env exactly once
      // and validates it. The UPPER_SNAKE keys are the dotenv wire format, not
      // naming choices.
      "includes": ["apps/web/src/shared/env.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noProcessGlobal": "off"
          },
          "style": {
            "noProcessEnv": "off",
            "useNamingConvention": "off"
          },
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      // drizzle.config.ts runs in drizzle-kit's CLI context (also inside the
      // migration container, where only DATABASE_URL exists) and must not pull
      // the full app env.
      "includes": ["packages/db/drizzle.config.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noProcessGlobal": "off"
          },
          "style": {
            "noProcessEnv": "off"
          },
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      // TanStack Start server routes: handler keys are the HTTP verbs
      // (GET/POST) and splat route files must be named `$.ts` — both are
      // framework contracts, not naming choices. The tick route reads the
      // token the serving process put into its own environment at boot, which
      // no Turbo task declares because no task inherits it.
      "includes": ["apps/web/src/routes/api/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noProcessGlobal": "off"
          },
          "style": {
            "noProcessEnv": "off",
            "useFilenamingConvention": "off",
            "useNamingConvention": "off"
          },
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      // The TanStack Start document shell renders the literal <head> element;
      // noHeadElement is a Next.js-domain rule and this is not a Next app.
      // Biome's resolver also cannot follow Vite's `?url` asset-query imports
      // for the stylesheets; Vite and tsc remain the authoritative resolvers.
      "includes": [
        "apps/web/src/routes/__root.tsx",
        "apps/web/src/shared/ui/application-style-sheets.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          },
          "style": {
            "noHeadElement": "off"
          }
        }
      }
    },
    {
      // The production server and the migration script run only under Bun,
      // never in a browser or on an edge runtime, which is what
      // noNodejsModules protects; the `Bun` global comes from that runtime.
      // PORT and DATABASE_URL are handed to the process at launch (`bun run
      // start`, the a11y web server, the migration container), not inherited
      // from a Turbo task, so noUndeclaredEnvVars has nothing to check them
      // against. The server also sets the tick token into its own environment
      // before loading the bundle.
      "includes": ["apps/web/scripts/**"],
      "javascript": {
        "globals": ["Bun"]
      },
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off"
          },
          "style": {
            "noProcessEnv": "off"
          },
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      // The media store runs on the server only. It uses Node's file APIs so
      // the Vite dev server (Node) and the production server (Bun) behave the
      // same, and reaches for the `Bun` global only for the S3 client, after
      // checking the runtime provides it.
      "includes": ["apps/web/src/shared/media/media-store.ts"],
      "javascript": {
        "globals": ["Bun"]
      },
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off"
          }
        }
      }
    },
    {
      // noImgElement is a Next.js rule about its <Image> component. This is a
      // Vite app; the garment figure and its enlarged view render a plain
      // <img> with explicit dimensions and async decoding, which is the right
      // tag.
      "includes": [
        "apps/web/src/shared/ui/garment-figure.tsx",
        "apps/web/src/shared/ui/enlargeable-figure.tsx"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          }
        }
      }
    },
    {
      // TanStack Router spells a dynamic path segment as `$name` in the file
      // name; the `$` is the framework's routing syntax.
      "includes": ["apps/web/src/routes/**/*.$*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      // The theme's component classes (`type-display`, `garment-frame`, …) are
      // applied through shared class constants and `[...].join(' ')` arrays,
      // never as a lone `className` literal, so noUnusedClasses reports every
      // selector in this file as dead.
      "includes": ["apps/web/src/styles.css"],
      "linter": {
        "rules": {
          "nursery": {
            "noUnusedClasses": "off"
          }
        }
      }
    }
  ]
}
