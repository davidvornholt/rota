{
  "name": "@rota/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=./apps/*",
    "standards": "standards",
    "check": "standards check && turbo run lint check-types test build test:a11y --output-logs=errors-only",
    "check:fix": "standards check && turbo run lint:fix check-types test build test:a11y --output-logs=errors-only",
    "test:a11y": "turbo run test:a11y"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@davidvornholt/standards": "0.27.0",
    "turbo": "^2.11.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "26"
  },
  "packageManager": "bun@1.4.2",
  "devDatabase": {
    "postgresVersion": "18"
  },
  "patchedDependencies": {
    "drizzle-kit@0.31.11": "patches/drizzle-kit@0.31.11.patch"
  }
}
